# apps/api configuration (see src/config.ts). Real values live in the host's secret manager.
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://postgres:tilt@127.0.0.1:55432/tilt_api

# Relay (apps/wallet), private network only
RELAY_URL=http://127.0.0.1:8787
RELAY_API_KEY=replace-with-a-random-secret-of-32-chars-or-more
RELAY_TIMEOUT_MS=15000

SOLANA_RPC_URL=http://127.0.0.1:8899
ROLLUP_RPC_URL=http://127.0.0.1:7799
ROLLUP_WS_URL=ws://127.0.0.1:7800

PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_KEY_QUORUM_ID=
PRIVY_POLICY_ID=

# CORS origin of the web app, and the public URL used in the device-login link
WEB_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

# Geo-blocking (spec §12). Comma-separated ISO codes; defaults to the built-in list.
# BLOCKED_COUNTRIES=US,GB,FR
COUNTRY_HEADER=x-vercel-ip-country
# Local development has no country header: allow it there only.
GEO_ALLOW_UNKNOWN=true
TRUST_PROXY=false

# Rate limits, requests per minute
RATE_GLOBAL_PER_MIN=6000
RATE_IP_PER_MIN=240
RATE_TOKEN_PER_MIN=180
RATE_AUTH_PER_MIN=10
RATE_PLAY_PER_MIN=60
RATE_MONEY_PER_MIN=6

INDEXER_BACKFILL_MS=30000
