# Relay configuration (validated by src/config.ts, which documents each variable).
# Secrets come from the host's secret manager in production, never from a committed file.

HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgres://postgres:tilt@127.0.0.1:5432/tilt
# Comma-separated, each at least 32 characters (two during a rotation).
RELAY_API_KEYS=
SOLANA_RPC_URL=https://api.devnet.solana.com
ROLLUP_RPC_URL=https://devnet-eu.magicblock.app
ROLLUP_WS_URL=wss://devnet-eu.magicblock.app
VRF_QUEUE=
# JSON array of 64 bytes.
RELAYER_SECRET_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=

# Relay-side limits, in USDC base units (defaults shown).
MAX_DEPOSIT=1000000000
DAILY_DEPOSIT_LIMIT=5000000000
DAILY_DEPOSIT_LIMIT_GLOBAL=100000000000
MIN_PROMO_PAYOUT=1000000
MAX_PROMO_PAYOUT=1000000000
DAILY_PROMO_LIMIT=5000000000

CRON_INTERVAL_MS=30000
CHECKPOINT_MIN_LOSS=1000000
CHECKPOINT_INTERVAL_MS=3600000
# What the house's risk pool keeps free for new rounds beyond open rounds (USDC base units; never less than max_round_gain).
RISK_POOL_TARGET=1000000000
MIN_RELAYER_LAMPORTS=500000000
MIN_ESCROW_LAMPORTS=2000000
MIN_FREE_BANKROLL=100000000
