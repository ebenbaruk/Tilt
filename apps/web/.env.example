# NEXT_PUBLIC_* values ship to the browser. Never put a secret in a NEXT_PUBLIC_ variable.

# Origin of apps/api, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Privy dashboard > App settings.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: Privy app client id (only when the app uses several clients).
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# mainnet | devnet | localnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional: rollup RPC, used to link round transactions in the Solana explorer (custom cluster).
NEXT_PUBLIC_ROLLUP_RPC_URL=

# Server only, never NEXT_PUBLIC_: the landing's waitlist writes to a Notion database.
# A Notion internal integration token, with the "Tilt waitlist" database shared to it.
NOTION_TOKEN=
NOTION_WAITLIST_DATA_SOURCE_ID=8750e031-f371-4c29-862d-28ac2637a9e7
# true on the public waitlist deployment: every page but the landing and legal pages redirects to /.
LANDING_ONLY=
# Server only. Set on a deployment whose api lives on another host (the site on Vercel, the api on a
# server): /v1 and /health are relayed there, so the site and the api share one origin, which the mod
# requires; NEXT_PUBLIC_API_URL is then the site's own origin. EDGE_SECRET (32+ characters) goes in
# x-tilt-edge, and the caller's address in x-tilt-client-ip, for the edge in front of the api.
API_UPSTREAM=
EDGE_SECRET=
